# Copy to .env for local runs (uv run --env-file .env uvicorn app:app --reload). On Vercel, set the same names under
# Project → Settings → Environment Variables. See README.md.

# GitHub token: Contents read/write on <username>/<username> and Profile read/write (README.md, step 1)
GITHUB_TOKEN=
# Firebase project of the site (the site's VITE_APP_PROJECT_ID)
FIREBASE_PROJECT_ID=
# UID of the site's admin account (the one in the site's firestore.rules)
ADMIN_UID=
# Origins where the site's /admin runs, comma separated
ALLOWED_ORIGINS=https://majidev.netlify.app,http://localhost:5173
# Random string Vercel Cron sends to /github/refresh, e.g. from: openssl rand -hex 32
CRON_SECRET=
